@model ChangePasswordVm
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="container-xl page-head"><h1 class="h3">Đổi mật khẩu</h1></div>
<div class="container-xl pb-5 account-layout">
    <partial name="_AccountNav" />
    <form method="post" class="panel">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" class="form-control mb-2" />
        <label class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control mb-2" />
        <label class="form-label">Xác nhận</label><input asp-for="ConfirmPassword" class="form-control mb-3" />
        <button class="btn-primary">Đổi mật khẩu</button>
    </form>
</div>
