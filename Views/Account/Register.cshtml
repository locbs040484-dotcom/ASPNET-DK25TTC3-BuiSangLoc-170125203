@model RegisterVm
@{ ViewData["Title"] = "Đăng ký"; }
<div class="auth-card">
    <h1 class="h4">Tạo tài khoản</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label class="form-label">Họ tên</label><input asp-for="FullName" class="form-control mb-2" />
        <label class="form-label">Email</label><input asp-for="Email" class="form-control mb-2" />
        <label class="form-label">Số điện thoại</label><input asp-for="Phone" class="form-control mb-2" />
        <label class="form-label">Mật khẩu</label><input asp-for="Password" class="form-control mb-2" />
        <label class="form-label">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" class="form-control mb-3" />
        <input type="hidden" asp-for="ReturnUrl" />
        <button class="btn-primary w-100" type="submit">Đăng ký</button>
    </form>
    <p class="mt-3 mb-0">Đã có tài khoản? <a href="/account/login">Đăng nhập</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
