@model List<ProductCardVm>
@{ ViewData["Title"] = "Yêu thích"; }
<div class="container-xl page-head"><div class="breadcrumb"><a href="/">Trang chủ</a> › Yêu thích</div><h1 class="h3">Sản phẩm yêu thích</h1></div>
<div class="container-xl pb-5 account-layout">
    <partial name="_AccountNav" />
    <div>
        @if (!Model.Any())
        {
            <div class="empty-state"><h3>Chưa có laptop yêu thích</h3><a class="btn-primary" href="/products">Khám phá laptop</a></div>
        }
        else
        {
            <div class="product-grid">@foreach (var p in Model) { <partial name="_ProductCard" model="p" /> }</div>
        }
    </div>
</div>
