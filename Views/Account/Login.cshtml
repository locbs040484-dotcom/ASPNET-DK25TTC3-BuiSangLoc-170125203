@model LoginVm
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-card">
    <h1 class="h4">Đăng nhập</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label class="form-label">Email</label><input asp-for="Email" class="form-control mb-2" />
        <label class="form-label">Mật khẩu</label><input asp-for="Password" class="form-control mb-2" />
        <label class="mb-3"><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label>
        <input type="hidden" asp-for="ReturnUrl" />
        <button class="btn-primary w-100" type="submit">Đăng nhập</button>
    </form>
    <p class="mt-3 mb-0">Chưa có tài khoản? <a href="/account/register">Đăng ký</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
