@model BlogPost
@{ ViewData["Title"] = Model.MetaTitle ?? Model.Title; ViewData["MetaDescription"] = Model.MetaDescription; var related = ViewBag.Related as List<BlogPost> ?? new(); }
<div class="container-xl page-head">
    <div class="breadcrumb"><a href="/">Trang chủ</a> › <a href="/blog">Tin tức</a> › @Model.Title</div>
</div>
<div class="container-xl pb-5">
    <article class="panel">
        <img src="@Model.Thumbnail" alt="" style="width:100%;height:320px;object-fit:cover;border-radius:8px" />
        <h1 class="mt-3">@Model.Title</h1>
        <div class="muted mb-3">@Model.Author · @Model.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
        @Html.Raw(Model.Content)
    </article>
    <h3 class="mt-4">Bài viết khác</h3>
    <div class="blog-grid">
        @foreach (var p in related)
        {
            <a class="blog-card" href="/blog/@p.Slug"><img src="@p.Thumbnail" alt="" /><div class="body"><h5>@p.Title</h5></div></a>
        }
    </div>
</div>
