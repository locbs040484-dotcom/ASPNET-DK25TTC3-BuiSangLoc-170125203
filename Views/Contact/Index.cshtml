@model ContactMessage
@{ ViewData["Title"] = "Liên hệ"; }
<div class="container-xl page-head"><div class="breadcrumb"><a href="/">Trang chủ</a> › Liên hệ</div><h1 class="h3">Liên hệ LaptopZone</h1></div>
<div class="container-xl pb-5">
    <div class="row g-4">
        <div class="col-lg-5 panel">
            <p>Hotline 1900 6868 · support@laptopzone.vn</p>
            <p>12 Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh</p>
            <p>Giờ làm việc: 8:30 – 21:00 mỗi ngày.</p>
        </div>
        <form method="post" class="col-lg-7 panel">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label class="form-label">Họ tên</label><input asp-for="Name" class="form-control mb-2" />
            <label class="form-label">Email</label><input asp-for="Email" class="form-control mb-2" />
            <label class="form-label">Số điện thoại</label><input asp-for="Phone" class="form-control mb-2" />
            <label class="form-label">Chủ đề</label><input asp-for="Subject" class="form-control mb-2" />
            <label class="form-label">Nội dung</label><textarea asp-for="Message" class="form-control mb-3" rows="5"></textarea>
            <button class="btn-primary">Gửi liên hệ</button>
        </form>
    </div>
</div>
