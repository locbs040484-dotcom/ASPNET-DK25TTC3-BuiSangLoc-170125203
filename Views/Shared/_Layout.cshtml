<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "LaptopZone") - Laptop chính hãng</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "LaptopZone - Website thương mại điện tử bán laptop chính hãng, bảo hành rõ ràng.")" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()
    <div id="toast-stack" class="toast-stack"></div>
    @if (TempData["Toast"] != null)
    {
        <script>window.addEventListener('DOMContentLoaded', () => showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Toast"]?.ToString()))));</script>
    }
    @await Component.InvokeAsync("HeaderStats")
    <main>
        @RenderBody()
    </main>
    <partial name="_Footer" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
