@model CartVm
@{ ViewData["Title"] = "Giỏ hàng"; }
<div class="container-xl page-head">
    <div class="breadcrumb"><a href="/">Trang chủ</a> › Giỏ hàng</div>
    <h1 class="h3">Giỏ hàng</h1>
</div>
<div class="container-xl pb-5">
    @if (!Model.Items.Any())
    {
        <div class="empty-state">
            <h3>Giỏ hàng của bạn đang trống</h3>
            <p class="muted">Khám phá những mẫu laptop phù hợp với bạn.</p>
            <a class="btn-primary" href="/products">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <table class="table-cart">
                    <thead><tr><th>Sản phẩm</th><th>Giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr data-item="@i.Id">
                            <td>
                                <div class="d-flex gap-2 align-items-center">
                                    <img src="@i.ImageUrl" width="72" style="object-fit:contain" alt="" />
                                    <a href="/products/@i.Slug">@i.Name</a>
                                </div>
                            </td>
                            <td>@CurrencyHelper.ToVnd(i.Price)</td>
                            <td>
                                <div class="qty-box">
                                    <button type="button" onclick="updateQty(@i.Id, @(i.Quantity-1))">-</button>
                                    <input value="@i.Quantity" onchange="updateQty(@i.Id, this.value)" />
                                    <button type="button" onclick="updateQty(@i.Id, @(i.Quantity+1))">+</button>
                                </div>
                            </td>
                            <td>@CurrencyHelper.ToVnd(i.SubTotal)</td>
                            <td><button class="btn-outline btn-sm" onclick="removeItem(@i.Id)">Xóa</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <form method="post" asp-action="Clear" class="mt-3"><button class="btn-outline">Xóa tất cả</button></form>
            </div>
            <div class="col-lg-4">
                <div class="summary-box">
                    <h4>Tóm tắt</h4>
                    <div class="d-flex justify-content-between"><span>Tạm tính</span><span id="sub">@CurrencyHelper.ToVnd(Model.SubTotal)</span></div>
                    <div class="d-flex justify-content-between"><span>Giảm giá</span><span id="disc">@CurrencyHelper.ToVnd(Model.Discount)</span></div>
                    <div class="d-flex justify-content-between"><span>Phí vận chuyển</span><span id="ship">@CurrencyHelper.ToVnd(Model.ShippingFee)</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold"><span>Tổng thanh toán</span><span id="tot" class="price">@CurrencyHelper.ToVnd(Model.Total)</span></div>
                    <div class="mt-3 d-flex gap-2">
                        <input id="voucher" class="form-control" placeholder="Mã giảm giá" value="@Model.VoucherCode" />
                        <button class="btn-outline" type="button" onclick="applyVoucher()">Áp dụng</button>
                    </div>
                    <div id="vmsg" class="small mt-2">@Model.VoucherMessage</div>
                    <a class="btn-primary w-100 mt-3" href="/checkout">Tiến hành đặt hàng</a>
                </div>
            </div>
        </div>
    }
</div>
@section Scripts {
<script>
async function updateQty(id, qty){
  const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
  const res = await fetch('/cart/update', {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:new URLSearchParams({itemId:id, quantity:qty, __RequestVerificationToken:token})});
  const j = await res.json(); showToast(j.message, j.ok?'success':'error'); if(j.ok){ location.reload(); }
}
async function removeItem(id){
  const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
  const res = await fetch('/cart/remove', {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:new URLSearchParams({itemId:id, __RequestVerificationToken:token})});
  const j = await res.json(); showToast(j.message); location.reload();
}
async function applyVoucher(){
  const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
  const res = await fetch('/cart/voucher', {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:new URLSearchParams({code:document.getElementById('voucher').value, __RequestVerificationToken:token})});
  const j = await res.json(); document.getElementById('vmsg').textContent=j.message; if(j.ok){ document.getElementById('disc').textContent=j.discount; document.getElementById('ship').textContent=j.shipping; document.getElementById('tot').textContent=j.total; }
  showToast(j.message, j.ok?'success':'error');
}
</script>
}
