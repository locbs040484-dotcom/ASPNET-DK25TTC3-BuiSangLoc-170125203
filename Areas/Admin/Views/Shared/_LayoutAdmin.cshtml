@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(ctrl, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin") - LaptopZone</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()
    <div id="toast-stack" class="toast-stack"></div>
    @if (TempData["Toast"] != null)
    {
        <script>window.addEventListener('DOMContentLoaded', () => showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Toast"]?.ToString()))));</script>
    }
    <div class="admin-shell">
        <aside class="admin-side">
            <a class="logo d-block mb-3" href="/admin" style="color:#fff">Laptop<span>Zone</span></a>
            <button class="btn btn-outline-light btn-sm d-lg-none mb-2" data-bs-toggle="collapse" data-bs-target="#adminside">Menu</button>
            <div id="adminside" class="collapse d-lg-block">
                <a class="@Active("Dashboard")" href="/admin"><i class="bi bi-grid"></i> Dashboard</a>
                <a class="@Active("Products")" href="/admin/products"><i class="bi bi-laptop"></i> Products</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="@Active("Categories")" href="/admin/categories"><i class="bi bi-tags"></i> Categories</a>
                    <a class="@Active("Brands")" href="/admin/brands"><i class="bi bi-award"></i> Brands</a>
                    <a class="@Active("Specs")" href="/admin/specs"><i class="bi bi-cpu"></i> Thông số</a>
                }
                <a class="@Active("Orders")" href="/admin/orders"><i class="bi bi-receipt"></i> Orders</a>
                <a class="@Active("Customers")" href="/admin/customers"><i class="bi bi-people"></i> Customers</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="@Active("Staff")" href="/admin/staff"><i class="bi bi-person-badge"></i> Staff</a>
                    <a class="@Active("Roles")" href="/admin/roles"><i class="bi bi-shield"></i> Roles</a>
                }
                <a class="@Active("Inventory")" href="/admin/inventory"><i class="bi bi-box"></i> Inventory</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="@Active("Vouchers")" href="/admin/vouchers"><i class="bi bi-ticket"></i> Voucher</a>
                }
                <a class="@Active("Reviews")" href="/admin/reviews"><i class="bi bi-star"></i> Reviews</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="@Active("BlogAdmin")" href="/admin/blogadmin"><i class="bi bi-journal-text"></i> Blog</a>
                    <a class="@Active("Banners")" href="/admin/banners"><i class="bi bi-image"></i> Banner</a>
                }
                <a class="@Active("Contacts")" href="/admin/contacts"><i class="bi bi-envelope"></i> Contact</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="@Active("Settings")" href="/admin/settings"><i class="bi bi-gear"></i> Settings</a>
                }
                <a href="/"><i class="bi bi-shop"></i> Về cửa hàng</a>
            </div>
        </aside>
        <div class="admin-main">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
