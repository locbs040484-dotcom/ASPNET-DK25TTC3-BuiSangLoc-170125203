@model WebsiteSetting
<form method="post" class="panel">
    <input asp-for="StoreName" class="form-control mb-2" />
    <input asp-for="Hotline" class="form-control mb-2" />
    <input asp-for="Email" class="form-control mb-2" />
    <input asp-for="Address" class="form-control mb-2" />
    <input asp-for="BankName" class="form-control mb-2" />
    <input asp-for="BankAccountNumber" class="form-control mb-2" />
    <input asp-for="BankAccountName" class="form-control mb-2" />
    <input asp-for="DefaultShippingFee" class="form-control mb-2" />
    <input asp-for="FreeShippingThreshold" class="form-control mb-2" />
    <button class="btn-primary">Lưu cấu hình</button>
</form>
