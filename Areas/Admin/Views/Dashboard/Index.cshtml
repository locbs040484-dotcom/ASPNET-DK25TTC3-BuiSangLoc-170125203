@model DashboardVm
@{ ViewData["Title"] = "Dashboard"; }
<h1 class="h4 mb-3">Dashboard</h1>
<div class="stat-grid mb-4">
    <div class="stat-card"><div class="muted">Doanh thu</div><div class="num">@CurrencyHelper.ToVnd(Model.TotalRevenue)</div><small>Hôm nay @CurrencyHelper.ToVnd(Model.TodayRevenue) · Tháng @CurrencyHelper.ToVnd(Model.MonthRevenue)</small></div>
    <div class="stat-card"><div class="muted">Đơn hàng</div><div class="num">@Model.TotalOrders</div><small>Chờ @Model.PendingOrders · Giao @Model.ShippingOrders · Xong @Model.CompletedOrders · Hủy @Model.CancelledOrders</small></div>
    <div class="stat-card"><div class="muted">Khách hàng</div><div class="num">@Model.TotalCustomers</div></div>
    <div class="stat-card"><div class="muted">Sản phẩm</div><div class="num">@Model.TotalProducts</div><small>Sắp hết @Model.LowStockCount</small></div>
</div>
<div class="row g-3">
    <div class="col-lg-6 panel"><canvas id="rev"></canvas></div>
    <div class="col-lg-6 panel"><canvas id="ord"></canvas></div>
    <div class="col-lg-4 panel"><canvas id="st"></canvas></div>
    <div class="col-lg-4 panel">
        <h5>Top laptop bán chạy</h5>
        @foreach (var p in Model.TopProducts) { <div class="d-flex justify-content-between"><span>@p.Name</span><strong>@p.Sold</strong></div> }
        <h6 class="mt-3">Top thương hiệu</h6>
        @foreach (var b in Model.TopBrands) { <div class="d-flex justify-content-between"><span>@b.Name</span><strong>@b.Sold</strong></div> }
    </div>
    <div class="col-lg-4 panel">
        <h5>Sắp hết hàng</h5>
        @foreach (var p in Model.LowStock)
        {
            <div class="d-flex justify-content-between"><span>@p.Name</span><span class="status-badge badge-danger">@p.Stock</span></div>
        }
    </div>
</div>
@section Scripts {
<script>
new Chart(document.getElementById('rev'), { type:'line', data:{ labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels)), datasets:[{label:'Doanh thu', data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenue)), borderColor:'#2563eb', tension:.3}] }});
new Chart(document.getElementById('ord'), { type:'bar', data:{ labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels)), datasets:[{label:'Số đơn', data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyOrders)), backgroundColor:'#2563eb'}] }});
new Chart(document.getElementById('st'), { type:'doughnut', data:{ labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusLabels)), datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusCounts)), backgroundColor:['#f59e0b','#2563eb','#6366f1','#06b6d4','#16a34a','#dc2626']}] }});
</script>
}
